<odoo>

<record id="facturx_analysis_form" model="ir.ui.view">
    <field name="model">facturx.analysis</field>
    <field name="arch" type="xml">
        <form string="Factur-X Analysis">
            <header>
                <button name="analyse" type="object" string="Analyse" invisible="state != 'draft'" class="btn-primary"/>
                <button name="print_report" type="object" string="Print Report" invisible="state != 'done'" class="btn-primary"/>
                <button name="back_to_draft" type="object" string="Back to Draft" invisible="state != 'done'" groups="base.group_system"/>
                <field name="state" widget="statusbar"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <label for="name" string="Factur-X Analysis"/>
                    <h1>
                        <field name="name"/>
                    </h1>
                </div>
                <group name="top">
                    <group name="input" string="Input">
                        <field name="title"/>
                        <field name="partner_id"/>
                        <field name="facturx_file" filename="facturx_filename" readonly="state == 'done'"/>
                        <field name="facturx_filename" invisible="1"/>
                        <label for="facturx_file_size"/>
                        <div name="facturx_file_size">
                            <field name="facturx_file_size" class="oe_inline"/>
                            Kb
                        </div>
                        <field name="facturx_file_sha1"/>
                        <field name="file_type" widget="badge" decoration-info="file_type == 'xml'"/>
                        <field name="date" invisible="state != 'done'"/>
                    </group>
                    <group name="result" string="Results" invisible="state == 'draft'">
                        <field name="doc_type" widget="badge" decoration-warning="doc_type == 'facturx'" decoration-danger="doc_type == 'orderx'" decoration-info="doc_type == 'ubl'" decoration-success="doc_type == 'cii'" decoration-secondary="doc_type == 'cdar'"/>
                        <field name="xmp_file" filename="xmp_filename" invisible="file_type != 'pdf'"/>
                        <field name="xmp_filename" invisible="1"/>
                        <field name="xml_file" filename="xml_filename" invisible="file_type != 'pdf'"/>
                        <field name="xml_filename" invisible="1"/>
                        <field name="valid"/>
                        <field name="pdfa3_valid" invisible="file_type != 'pdf'"/>
                        <field name="xmp_valid" invisible="file_type != 'pdf'"/>
                        <field name="xml_valid"/>
                        <field name="xml_schematron_valid" invisible="xml_profile not in ('facturx_minimum', 'facturx_basicwl', 'facturx_basic', 'facturx_en16931', 'facturx_extended', 'facturx_extended_ctc_fr', 'facturx_107_minimum', 'facturx_107_basicwl', 'facturx_107_basic', 'facturx_107_en16931', 'facturx_107_extended', 'orderx_basic', 'orderx_comfort', 'orderx_extended', 'ubl_en16931', 'ubl_extended_ctc_fr', 'ubl_extended', 'cdar_ctc_fr', 'cii_en16931', 'cii_extended_ctc_fr', 'cii_extended')"/>
                        <field name="xml_schematron_profile_valid" string="Schematron Profile valid" invisible="xml_profile not in ('facturx_minimum', 'facturx_basicwl', 'facturx_basic', 'facturx_en16931', 'facturx_extended', 'facturx_extended_ctc_fr', 'facturx_107_minimum', 'facturx_107_basicwl', 'facturx_107_basic', 'facturx_107_en16931', 'facturx_107_extended', 'orderx_basic', 'orderx_comfort', 'orderx_extended', 'ubl_en16931', 'ubl_extended_ctc_fr', 'ubl_extended', 'cdar_ctc_fr', 'cii_en16931', 'cii_extended_ctc_fr', 'cii_extended')"/>
                        <field name="xml_schematron_br_fr_valid" string="Schematron BR-FR valid" invisible="xml_profile not in ('facturx_basicwl', 'facturx_basic', 'facturx_en16931', 'facturx_extended', 'facturx_extended_ctc_fr', 'facturx_107_basicwl', 'facturx_107_basic', 'facturx_107_en16931', 'facturx_107_extended', 'ubl_en16931', 'ubl_extended_ctc_fr', 'ubl_extended', 'cii_en16931', 'cii_extended_ctc_fr', 'cii_extended')"/>
                        <field name="nonblocking_count" string="Schematron Warnings" invisible="not nonblocking_count"/>
                        <field name="xmp_profile" invisible="file_type != 'pdf'"/>
                        <field name="xml_profile"/>
                        <field name="afrelationship" invisible="file_type != 'pdf'"/>
                        <field name="xmp_orderx_type" invisible="doc_type != 'orderx' or file_type != 'pdf'"/>
                        <field name="xml_orderx_type" invisible="doc_type != 'orderx'"/>
                    </group>
                </group>
                <div name="errors" invisible="not error_ids">
                    <separator string="PDF/A-3 Errors" invisible="not error_pdfa3_ids"/>
                    <field name="error_pdfa3_ids" nolabel="1" invisible="not error_pdfa3_ids">
                        <list create="false" delete="false" decoration-warning="severity == 'warning'" decoration-muted="severity == 'info'">
                            <field name="severity" widget="badge" decoration-danger="severity == 'error'" decoration-warning="severity == 'warning'" decoration-info="severity == 'info'"/>
                            <field name="rule_id" optional="hide"/>
                            <field name="name"/>
                            <field name="comment"/>
                        </list>
                    </field>
                    <separator string="XMP Errors" invisible="not error_xmp_ids"/>
                    <field name="error_xmp_ids" nolabel="1" invisible="not error_xmp_ids">
                        <list create="false" delete="false" decoration-warning="severity == 'warning'" decoration-muted="severity == 'info'">
                            <field name="severity" widget="badge" decoration-danger="severity == 'error'" decoration-warning="severity == 'warning'" decoration-info="severity == 'info'"/>
                            <field name="rule_id" optional="hide"/>
                            <field name="name"/>
                            <field name="comment"/>
                        </list>
                    </field>
                    <separator string="XML XSD Errors" invisible="not error_xml_ids"/>
                    <field name="error_xml_ids" nolabel="1" invisible="not error_xml_ids">
                        <list create="false" delete="false" decoration-warning="severity == 'warning'" decoration-muted="severity == 'info'">
                            <field name="severity" widget="badge" decoration-danger="severity == 'error'" decoration-warning="severity == 'warning'" decoration-info="severity == 'info'"/>
                            <field name="rule_id" optional="hide"/>
                            <field name="name"/>
                            <field name="comment"/>
                        </list>
                    </field>
                    <separator string="XML Schematron Profile Messages" invisible="not error_schematron_profile_ids"/>
                    <field name="error_schematron_profile_ids" nolabel="1" invisible="not error_schematron_profile_ids">
                        <list create="false" delete="false" decoration-warning="severity == 'warning'" decoration-muted="severity == 'info'">
                            <field name="severity" widget="badge" decoration-danger="severity == 'error'" decoration-warning="severity == 'warning'" decoration-info="severity == 'info'"/>
                            <field name="rule_id" optional="show"/>
                            <field name="name" string="failed-assert"/>
                            <field name="test_condition" string="When"/>
                            <field name="comment"/>
                        </list>
                    </field>
                    <separator string="XML Schematron BR-FR Messages" invisible="not error_schematron_br_fr_ids"/>
                    <field name="error_schematron_br_fr_ids" nolabel="1" invisible="not error_schematron_br_fr_ids">
                        <list create="false" delete="false" decoration-warning="severity == 'warning'" decoration-muted="severity == 'info'">
                            <field name="severity" widget="badge" decoration-danger="severity == 'error'" decoration-warning="severity == 'warning'" decoration-info="severity == 'info'"/>
                            <field name="rule_id" optional="show"/>
                            <field name="name" string="failed-assert"/>
                            <field name="test_condition" string="When"/>
                            <field name="comment"/>
                        </list>
                    </field>
                </div>
            </sheet>
        </form>
    </field>
</record>

<record id="facturx_analysis_tree" model="ir.ui.view">
    <field name="model">facturx.analysis</field>
    <field name="arch" type="xml">
        <list string="Factur-X Analysis" decoration-bf="valid == True">
            <field name="name"/>
            <field name="create_uid"/>
            <field name="title"/>
            <field name="facturx_filename"/>
            <field name="partner_id" optional="show"/>
            <field name="file_type" widget="badge" decoration-info="file_type == 'xml'"/>
            <field name="doc_type" widget="badge" decoration-warning="doc_type == 'facturx'" decoration-danger="doc_type == 'orderx'" decoration-info="doc_type == 'ubl'" decoration-success="doc_type == 'cii'" decoration-muted="doc_type == 'cdar'"/>
            <field name="xml_orderx_type" string="Order Type" optional="show"/>
            <field name="xml_profile" string="Profile"/>
            <field name="xmp_profile" invisible="file_type != 'pdf'" optional="hide"/>
            <field name="pdfa3_valid" invisible="file_type != 'pdf'" optional="hide"/>
            <field name="xmp_valid" invisible="file_type != 'pdf'" optional="hide"/>
            <field name="xml_valid" optional="hide"/>
            <field name="xml_schematron_valid" invisible="xml_profile not in ('facturx_minimum', 'facturx_basicwl', 'facturx_basic', 'facturx_en16931', 'facturx_extended', 'facturx_extended_ctc_fr', 'orderx_basic', 'orderx_comfort', 'orderx_extended', 'ubl_en16931', 'ubl_extended_ctc_fr', 'ubl_extended', 'cdar_ctc_fr', 'cii_en16931', 'cii_extended_ctc_fr', 'cii_extended')" optional="hide"/>
            <field name="xml_schematron_profile_valid" string="Schematron Profile" optional="hide"/>
            <field name="xml_schematron_br_fr_valid" string="Schematron BR-FR" optional="hide"/>
            <field name="nonblocking_count" string="Warnings" optional="hide"/>
            <field name="valid"/>
            <field name="date"/>
            <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'done'"/>
        </list>
    </field>
</record>

<record id="facturx_analysis_search" model="ir.ui.view">
    <field name="model">facturx.analysis</field>
    <field name="arch" type="xml">
        <search string="Search Factur-X Analysis">
            <field name="name" string="Number, Title or Filename" filter_domain="['|', '|', ('name', 'ilike', self), ('title', 'ilike', self), ('facturx_filename', 'ilike', self)]"/>
            <field name="partner_id"/>
            <filter name="my_analysis" string="My Analysis" domain="[('create_uid', '=', uid)]"/>
            <separator/>
            <filter name="no_analysed" string="Not Analysed" domain="[('state', '=', 'draft')]"/>
            <filter name="analysed" string="Analysed" domain="[('state', '=', 'done')]"/>
            <separator/>
            <filter name="facturx" string="Factur-X" domain="[('doc_type', '=', 'facturx')]"/>
            <filter name="orderx" string="Order-X" domain="[('doc_type', '=', 'orderx')]"/>
            <filter name="ubl"    string="UBL"     domain="[('doc_type', '=', 'ubl')]"/>
            <filter name="cii"    string="CII"     domain="[('doc_type', '=', 'cii')]"/>
            <filter name="cdar"   string="CDAR"    domain="[('doc_type', '=', 'cdar')]"/>
            <separator/>
            <filter name="pdf" string="PDF" domain="[('file_type', '=', 'pdf')]"/>
            <filter name="xml" string="XML" domain="[('file_type', '=', 'xml')]"/>
            <separator/>
            <filter name="valid" string="Valid" domain="[('state', '=', 'done'), ('valid', '=', True)]" />
            <filter name="invalid" string="Not Valid" domain="[('state', '=', 'done'), ('valid', '=', False)]" />
            <filter name="with_warnings" string="With Warnings" domain="[('nonblocking_count', '>', 0)]" />
            <group string="Group By" name="groupby">
                <filter name="partner_groupby" string="Partner" context="{'group_by': 'partner_id'}"/>
                <filter name="date_groupby" string="Analysis Date" context="{'group_by': 'date'}"/>
                <filter name="create_uid_groupby" string="Created By" context="{'group_by': 'create_uid'}"/>
                <filter name="state_groupby" string="State" context="{'group_by': 'state'}"/>
            </group>
        </search>
    </field>
</record>

<record id="facturx_analysis_pivot" model="ir.ui.view">
    <field name="model">facturx.analysis</field>
    <field name="arch" type="xml">
        <pivot>
            <field name="date" type="row"/>
            <field name="doc_type" type="col"/>
        </pivot>
    </field>
</record>

<record id="facturx_analysis_graph" model="ir.ui.view">
    <field name="model">facturx.analysis</field>
    <field name="arch" type="xml">
        <graph>
            <field name="date" interval="month"/>
        </graph>
    </field>
</record>

<record id="facturx_analysis_action" model="ir.actions.act_window">
    <field name="name">Analysis</field>
    <field name="res_model">facturx.analysis</field>
    <field name="view_mode">list,form,pivot,graph</field>
    <field name="context">{'search_default_my_analysis': True}</field>
</record>

<menuitem id="facturx_analysis_root" name="Factur-X" web_icon="facturx_validator,static/description/fx_menu_icon.png" sequence="-1"/>

<menuitem id="facturx_analysis_parent" name="Analysis" parent="facturx_analysis_root"/>

<menuitem id="facturx_analysis_menu" action="facturx_analysis_action" parent="facturx_analysis_parent" sequence="10"/>

<record id="partner_tree_action" model="ir.actions.act_window">
    <field name="name">Partners</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">list,form,kanban</field>
</record>

<menuitem id="facturx_partner_menu" action="partner_tree_action" parent="facturx_analysis_parent" sequence="20"/>

</odoo>
